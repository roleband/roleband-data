          {
            "name": "bonus_high",
            "type": "integer",
            "description": "Annual bonus target, high, percent of base."
          },
          {
            "name": "as_of",
            "type": "date",
            "description": "When the evidence for this row was read.",
            "constraints": {
              "required": true
            }
          },
          {
            "name": "note",
            "type": "string",
            "description": "For the reader of the file; not part of the model."
          }
