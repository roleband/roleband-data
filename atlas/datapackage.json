            "type": "string",
            "constraints": {
              "required": true
            }
          },
          {
            "name": "phrase",
            "type": "string",
            "description": "Lowercase words, single-spaced, as the title says them; punctuation is ignored.",
            "constraints": {
              "required": true
            }
          },
          {
            "name": "match",
            "type": "string",
            "description": "exact: the title's words are the phrase; prefix: they start with it; word: it appears among them as whole words.",
            "constraints": {
              "required": true,
              "enum": [
                "exact",
                "prefix",
                "word"
              ]
            }
          },
          {
            "name": "as_of",
            "type": "date",
            "description": "When the evidence was read.",
            "constraints": {
              "required": true
            }
          },
          {
            "name": "basis",
            "type": "string",
            "description": "The kind of evidence, never a site.",
            "constraints": {
              "required": true,
              "enum": [
                "employer_titles",
                "employer_posted_ranges",
                "government_disclosure",
                "employer_published",
                "reviewed_judgement",
                "unverified"
              ]
            }
          },
          {
            "name": "note",
            "type": "string",
            "description": "For the reader of the file; not part of the model."
          }
        ],
        "primaryKey": [
          "company",
          "family",
          "phrase"
        ],
        "foreignKeys": [
          {
            "fields": [
              "company",
              "family",
              "code"
            ],
            "reference": {
              "resource": "rungs",
              "fields": [
                "company",
                "family",
                "code"
              ]
            }
          }
        ]
      }
