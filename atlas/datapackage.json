{
  "name": "roleband-level-atlas",
  "title": "RoleBand level atlas",
  "description": "How each company levels its people and structures pay.",
  "licenses": [
    {
      "name": "CC-BY-4.0",
      "title": "Creative Commons Attribution 4.0"
    }
  ],
  "edition": "2026.11.02",
  "schema_version": "4.0.0",
  "profile": "tabular-data-package",
  "resources": [
    {
      "name": "companies",
      "path": "companies.csv",
      "profile": "tabular-data-resource",
      "description": "One row per employer the model knows, in the model's order.",
      "format": "csv",
      "encoding": "utf-8",
      "schema": {
        "fields": [
          {
            "name": "slug",
            "type": "string",
            "description": "tracked_company.slug",
            "constraints": {
              "required": true
            }
          },
          {
            "name": "parent",
            "type": "string",
            "description": "A sibling employer whose ladders this one shares (google-deepmind -> google)."
          },
          {
            "name": "printed_field",
            "type": "string",
            "description": "The public board field the employer prints its rung in; empty = the posting's text."
          },
          {
            "name": "senior_unconfirmed",
            "type": "boolean",
            "description": "A bare 'Senior' in this employer's titles is a weak signal: the posting reads senior, never confirmed (its ladder is not spoken in titles). Empty = false."
          },
          {
            "name": "as_of",
            "type": "date",
            "description": "When the evidence for this row was read.",
            "constraints": {
              "required": true
            }
          },
          {
            "name": "note",
            "type": "string",
            "description": "For the reader of the file; not part of the model."
          }
        ],
        "primaryKey": [
          "slug"
        ]
      }
    },
    {
      "name": "ladders",
      "path": "ladders.csv",
      "profile": "tabular-data-resource",
      "description": "A company's ladders, in the company's order. `family` is a taxonomy family or `company` (the company-wide row).",
      "format": "csv",
      "encoding": "utf-8",
      "schema": {
        "fields": [
          {
            "name": "company",
            "type": "string",
            "constraints": {
              "required": true
            }
          },
          {
            "name": "family",
            "type": "string",
            "constraints": {
              "required": true
            }
          },
          {
            "name": "guide",
            "type": "boolean",
            "description": "Shown in the Walk's level guide: a reviewed ladder.",
            "constraints": {
              "required": true
            }
          },
          {
            "name": "company_wide",
            "type": "boolean",
            "description": "The code grades every function; false: only `tracks`.",
            "constraints": {
              "required": true
            }
          },
          {
            "name": "tracks",
            "type": "string",
            "description": "Role tracks the code grades when not company-wide, `|`-separated."
          },
          {
            "name": "families",
            "type": "string",
            "description": "Other taxonomy families this ladder levels, `|`-separated."
          },
          {
            "name": "flat",
            "type": "boolean",
            "description": "The employer's titles state no level beyond these rungs: a band with no rung is unstated, not skipped. Empty = false."
          },
          {
            "name": "as_of",
            "type": "date",
            "description": "When the evidence for this row was read.",
            "constraints": {
              "required": true
            }
          },
          {
            "name": "note",
            "type": "string",
            "description": "For the reader of the file; not part of the model."
          }
        ],
        "primaryKey": [
          "company",
          "family"
        ],
        "foreignKeys": [
          {
            "fields": [
              "company"
            ],
            "reference": {
              "resource": "companies",
              "fields": [
                "slug"
              ]
            }
          }
        ]
      }
    },
    {
