      "profile": "tabular-data-resource",
      "description": "Phrases a company uses for one of its rungs in its postings: a title whose words meet one reads that rung. Phrases, never regexes.",
      "format": "csv",
      "encoding": "utf-8",
      "schema": {
        "fields": [
          {
            "name": "company",
            "type": "string",
            "constraints": {
              "required": true
            }
          },
