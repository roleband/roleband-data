            "type": "string",
            "constraints": {
              "required": true,
              "enum": [
                "bonus_rule",
                "equity_rule",
                "equity_vehicle",
                "vesting",
                "grant_term",
                "sign_on_bridges_vesting",
                "base_cap_usd",
                "annual_refresh",
                "verified"
